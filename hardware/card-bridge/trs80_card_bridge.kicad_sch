	(text "This card acts as the ECB CPU card: it starts the BAO/IEO daisy chains (pulled high),\npulls up WAIT*/INT*/NMI*/BUSRQ* and holds HALT*/BUSAK*/RFSH* inactive, A20-A23 low.\nc10 (EXTMEM*, used by the banked-memory card) is pulled up. BAI/IEI unused.\nD8-D15, IRQ0-7 and the other 16-bit/spare lines are left to the backplane."
		(exclude_from_sim no)
		(at 25.4 200.66 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "9d673fdd-7cea-590c-b2cb-8ca5817c4a87")
	)
	(text "TRS-80 MODEL I BUS  (right-angle 2x20 box header)"
