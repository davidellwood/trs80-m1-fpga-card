function [9:0] uentry(input [4:0] c);
    case (c)
        5'h02: uentry = 10'd165;   // SIN
        5'h03: uentry = 10'd172;   // COS
        5'h04: uentry = 10'd177;   // TAN
        5'h05: uentry = 10'd274;   // ASIN
        5'h06: uentry = 10'd292;   // ACOS
        5'h07: uentry = 10'd212;   // ATAN
        5'h08: uentry = 10'd50;   // LOG
        5'h09: uentry = 10'd46;   // LN
        5'h0a: uentry = 10'd2;   // EXP
        5'h0b: uentry = 10'd104;   // PWR
        default: uentry = 10'd0;
    endcase
endfunction
